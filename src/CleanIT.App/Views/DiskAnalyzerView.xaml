<UserControl x:Class="CleanIT.App.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanIT.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiskAnalyzerViewModel}"
             d:DesignWidth="1000" d:DesignHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Parcourir…" Command="{Binding BrowseCommand}" />
                    <Button Content="Analyser" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" />
                    <Button Content="Annuler" Command="{Binding AnalyzeCancelCommand}"
                            Visibility="{Binding AnalyzeCommand.IsRunning, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Emplacement :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Drives}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" MinWidth="320" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                  AutomationProperties.Name="Emplacement à analyser" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,2,0,0"
                               Visibility="{Binding SummaryText, Converter={StaticResource NotNullToVisible}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Folder tree -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Dossiers, du plus gros au plus petit" Style="{StaticResource Title}" Margin="8,4,8,8" />
                <TreeView ItemsSource="{Binding Tree}" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryNodeViewModel}" ItemsSource="{Binding Children}">
                            <Grid Margin="0,2" ToolTip="{Binding FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ouvrir dans l'Explorateur"
                                                  Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </Grid.Tag>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Largest files -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                    <Button DockPanel.Dock="Right" Content="Afficher dans l'Explorateur" Margin="0"
                            Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding SelectedFile.FullPath}" />
                    <TextBlock Text="Les 50 plus gros fichiers" Style="{StaticResource Title}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <ListView ItemsSource="{Binding LargestFiles}" SelectedItem="{Binding SelectedFile}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Taille" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modifié le" Width="90" DisplayMemberBinding="{Binding LastWriteUtc, StringFormat=d}" />
                            <GridViewColumn Header="Chemin" Width="420" DisplayMemberBinding="{Binding FullPath}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
